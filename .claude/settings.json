{
  "permissions": {
    "ask": [
      "Bash(git remote:*)",
      "Bash(rtk git remote:*)",
      "Bash(git branch -d:*)",
      "Bash(rtk git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(rtk git branch -D:*)",
      "Bash(git branch --delete:*)",
      "Bash(rtk git branch --delete:*)",
      "Bash(gh repo:*)",
      "Bash(rtk gh repo:*)",
      "Bash(git push --force:*)",
      "Bash(rtk git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rtk git push -f:*)"
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "caveman@caveman": true,
    "humanizer@humanizer": true,
    "ponytail@ponytail": true,
    "context-mode@context-mode": true,
    "genres@awesome-gamedev-agent-skills": false,
    "disciplines@awesome-gamedev-agent-skills": false,
    "workflows@awesome-gamedev-agent-skills": false,
    "router@awesome-gamedev-agent-skills": false,
    "taste-skill@local-desktop-app-uploads": true,
    "impeccable@local-desktop-app-uploads": true,
    "superdesign@claude-plugins-official": false,
    "ui-ux-pro-max@ui-ux-pro-max-skill": false,
    "unity@awesome-gamedev-agent-skills": false,
    "godot@awesome-gamedev-agent-skills": false,
    "godot-agent-kit@godot-agent-kit": false,
    "unreal@awesome-gamedev-agent-skills": false,
    "rpgmaker-mz@rpgmaker-mz-mcp": false,
    "gamedev@awesome-gamedev-agent-skills": false,
    "ebitengine@awesome-gamedev-agent-skills": false,
    "other-engines@awesome-gamedev-agent-skills": false,
    "web-engines@awesome-gamedev-agent-skills": false,
    "unity-perf@anthropic-plugin-directory": false,
    "unity@anthropic-plugin-directory": false,
    "unreal-engine-skills@anthropic-plugin-directory": false,
    "taste-skill@taste-skill": true,
    "impeccable@impeccable": true,
    "unreal-engine-skills-for-claude-code@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/rtk-safe-hook.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
