{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Warning",
      "ModelContextProtocol": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "ConnectionStrings": {
    "LorEvolveDb": "Data Source=/home/data/lorevolve.db"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "DataProtection": {
    "KeyRingPath": "/home/data/keys"
  },
  "Hosting": {
    "UseForwardedHeaders": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Media": {
    "Provider": "R2"
  }
}
