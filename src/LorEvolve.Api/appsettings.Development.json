{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "OpenIddict": "Warning",
      "ModelContextProtocol": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "LorEvolveDb": "Data Source=App_Data/lorevolve.dev.db"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Media": {
    "Provider": "InMemory"
  },
  "Assistant": {
    "Provider": "Fake"
  },
  "PublicSite": {
    "Origin": "http://localhost:5173",
    "AllowIndexing": true
  },
  "Frontend": {
    "ShellPath": "../LorEvolve.Web/index.html"
  }
}
